{
  "environments": {
    "jsonplaceholder": {
      "baseURL": "https://jsonplaceholder.typicode.com"
    },
    "restful-booker": {
      "baseURL": "https://restful-booker.herokuapp.com"
    }
  },
  "authProfiles": {
    "none": {},
    "smokeAuth": {
      "username": "admin",
      "password": "password123"
    }
  },
  "testProfiles": {
    "smoke": {
      "env": "jsonplaceholder",
      "auth": "none"
    },
    "auth_smoke": {
      "env": "restful-booker",
      "auth": "smokeAuth"
    }
  },
  "testType": "smoke",
  "runSettings": {
    "vus": 1,
    "duration": "10s"
  }
  ,
  "stageProfiles": {
    "local-smoke": {
      "stages": [
        { "duration": "30s", "target": 1 }
      ]
    },
    "ci-load": {
      "stages": [
        { "duration": "30s", "target": 20 },
        { "duration": "2m",  "target": 20 },
        { "duration": "30s", "target": 0 }
      ]
    },
    "spike": {
      "stages": [
        { "duration": "10s", "target": 50 },
        { "duration": "20s", "target": 50 },
        { "duration": "30s", "target": 0 }
      ]
    }
  },
  "defaultStageProfile": "local-smoke"
}